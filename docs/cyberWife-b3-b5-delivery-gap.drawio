      <mxCell id="p4r" value="Receiver [已实现]&#xa;持续收PCM/控制帧&#xa;只校验、入队，不等待推理" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="260" height="130" as="geometry"/></mxCell>
