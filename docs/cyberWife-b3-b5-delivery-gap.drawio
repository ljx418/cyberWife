      <mxCell id="p3gw" value="WSL App Gateway :7860 [已实现/分层达标]&#xa;&#xa;SessionRuntime / ConversationOrchestrator / TurnPipeline&#xa;InterruptionController / MemoryService / RetentionService&#xa;Repository / AssetStore / Logger由api/server.py组合根经Ports注入" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1E6B50;strokeColor=#70D6A7;strokeWidth=3;fontColor=#FFFFFF;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="440" height="260" as="geometry"/></mxCell>
