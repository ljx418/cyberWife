      <mxCell id="p3launch" value="RuntimeLauncher.ps1&#xa;start / status / recover / stop&#xa;真实functional probe" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="70" y="520" width="290" height="150" as="geometry"/></mxCell>
