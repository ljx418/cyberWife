      <mxCell id="p3e1" edge="1" parent="1" source="p3ui" target="p3gw" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#62B6BC;endArrow=block;"/><mxCell id="p3e2" edge="1" parent="1" source="p3gw" target="p3llm" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p3e3" edge="1" parent="1" source="p3gw" target="p3speech" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p3e4" edge="1" parent="1" source="p3gw" target="p3avatar" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p3e5" edge="1" parent="1" source="p3gw" target="p3data" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#62B6BC;endArrow=block;"/><mxCell id="p3e6" edge="1" parent="1" source="p3launch" target="p3gw" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6ED39C;endArrow=block;"/>
