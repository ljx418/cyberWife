  <diagram id="p6" name="06-B5发布与故障恢复">
    <mxGraphModel dx="1422" dy="762" grid="1" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="p6t" value="B5｜先补规格，再执行发布候选总验收" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1200" height="50" as="geometry"/></mxCell>
      <mxCell id="p6complete" value="B5-AC00 完整性硬门 [已完成]&#xa;&#xa;ConsentRepository + 撤销后素材阻断与脱敏审计&#xa;AssetRepository 版本/激活/回退&#xa;完整Profile并发与跨重启&#xa;App.tsx默认产品入口&#xa;SettingsDrawer六类真实API" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="420" height="260" as="geometry"/></mxCell>
      <mxCell id="p6fault" value="B5.2 故障与恢复 [已验收]&#xa;&#xa;LLM/Speech/Avatar/Gateway×3真实故障&#xa;错误影响与动作可见&#xa;recover API + functional probe&#xa;原页继续，不刷新" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="590" y="120" width="430" height="260" as="geometry"/></mxCell>
      <mxCell id="p6offline" value="B5.3 本机边界与隐私 [替代门通过]&#xa;&#xa;5轮→记忆查改删；仅loopback/本机桥接白名单&#xa;运行时连接采样与白盒出站=0&#xa;音频落盘=0｜日志/Git无敏感数据&#xa;物理断网按用户决议不执行" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="1120" y="120" width="410" height="260" as="geometry"/></mxCell>
      <mxCell id="p6release" value="B5.4～B5.6 独立复验 [FAIL]&#xa;&#xa;60分钟：20完整+10打断全PASS；RAM/GPU/趋势达门&#xa;Windows最低可用1,840.566MiB&lt;2GiB → soak exit 2&#xa;失败后跳过recover；stop×2、端口/PID归零PASS&#xa;另缺干净机安装、完整AC-11、分层与口型量化" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8B2E2E;strokeColor=#FF8C87;fontColor=#FFFFFF;align=left;spacing=18;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="510" width="1000" height="240" as="geometry"/></mxCell>
      <mxCell id="p6e1" edge="1" parent="1" source="p6complete" target="p6fault" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p6e2" edge="1" parent="1" source="p6fault" target="p6offline" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p6e3" edge="1" parent="1" source="p6offline" target="p6release" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/>
    </root></mxGraphModel>
  </diagram>
  <diagram id="p7" name="07-开发验收计划与里程碑">
    <mxGraphModel dx="1422" dy="762" grid="1" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="p7t" value="开发与验收计划｜每个子阶段都经过五道门" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1100" height="50" as="geometry"/></mxCell>
      <mxCell id="p7flow" value="① 根据PRD写计划/验收　→　② 开发前审计P0/P1=0　→　③ 最小实现+合同/集成　→　④ 真实数据E2E　→　⑤ PRD规格检视与出门" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="110" width="1420" height="90" as="geometry"/></mxCell>
      <mxCell id="p7b3" value="B3 [完成]&#xa;全双工WS / 统一取消&#xa;浏览器与Avatar generation清理&#xa;30打断 / 100轮授权音频 / 1h&#xa;&#xa;证据：interrupt / stress / soak / resource" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=17;" vertex="1" parent="1"><mxGeometry x="90" y="280" width="400" height="300" as="geometry"/></mxCell>
      <mxCell id="p7b4" value="B4 [完成]&#xa;sqlite-vec/BGE / 形成召回&#xa;编辑/删除/全清 / no-record&#xa;30天保留 / 数据隐私E2E&#xa;&#xa;证据：DB四层diff / no-record / retention" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=17;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="400" height="300" as="geometry"/></mxCell>
      <mxCell id="p7b5" value="B5 [发布阻断]&#xa;功能链30/30通过；G4资源硬门失败&#xa;失败后生命周期按设计停止&#xa;&#xa;待闭环：宿主余量根因、真读屏/麦克风、干净机安装&#xa;已关闭：分层、口型量化" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8B2E2E;strokeColor=#FF8C87;fontColor=#FFFFFF;align=left;spacing=17;" vertex="1" parent="1"><mxGeometry x="1110" y="280" width="400" height="300" as="geometry"/></mxCell>
      <mxCell id="p7stop" value="停线规则：真实验收失败→返回本阶段计划；P0/P1、隐私泄漏、资源越门或证据失真→停止自动开发并报告；不得降低硬门或用mock替代。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#632D34;strokeColor=#FF8C8C;fontColor=#FFFFFF;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="690" width="1180" height="100" as="geometry"/></mxCell>
      <mxCell id="p7e1" edge="1" parent="1" source="p7b3" target="p7b4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p7e2" edge="1" parent="1" source="p7b4" target="p7b5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/>
    </root></mxGraphModel>
  </diagram>
  <diagram id="p8" name="08-V1验收门槛与出门">
    <mxGraphModel dx="1422" dy="762" grid="1" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="p8t" value="V1验收门槛与出门条件｜用户场景 + 操作 + 量化门" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1300" height="50" as="geometry"/></mxCell>
      <mxCell id="p8g1" value="G1 需求完整 [黄]&#xa;FR-01～20 / NFR-01～10&#xa;NFR-07已关闭；NFR-08仍待完整场景" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="270" height="130" as="geometry"/></mxCell>
      <mxCell id="p8g2" value="G2 主体验 [黄]&#xa;20轮/首响/打断/FPS通过&#xa;真麦克风与A/V同步量化待补" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="340" height="130" as="geometry"/></mxCell>
      <mxCell id="p8g3" value="G3 数据隐私 [绿/替代门]&#xa;删除0召回｜不记录0写入｜出站0｜音频落盘0&#xa;物理断网由用户批准替代" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="350" height="130" as="geometry"/></mxCell>
      <mxCell id="p8g4" value="G4 稳定性能 [红]&#xa;本轮：RAM 13,637.863MiB｜GPU 12.479GiB&#xa;Windows余量1,840.566MiB&lt;2GiB" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8B2E2E;strokeColor=#FF8C87;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="120" width="370" height="130" as="geometry"/></mxCell>
      <mxCell id="p8g5" value="G5 可用性 [黄]&#xa;记忆/恢复、三视口axe与焦点通过&#xa;真实读屏+每视口完整任务待验" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="360" width="400" height="140" as="geometry"/></mxCell>
      <mxCell id="p8g6" value="G6 可运维 [黄]&#xa;目标机启动/备份/恢复/卸载/清除通过&#xa;干净机安装未演练" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="360" width="420" height="140" as="geometry"/></mxCell>
      <mxCell id="p8go" value="V1 阶段验收 FAIL / 发布阻断&#xa;&#xa;核心对话30/30成功，但G4宿主内存余量硬门失败&#xa;G1/G2/G5/G6另有可验证黄项，禁止标记全绿&#xa;自动化停止：先定位资源红项；商业用途仍为NO-GO" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8B2E2E;strokeColor=#FF8C87;fontColor=#FFFFFF;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="610" width="940" height="190" as="geometry"/></mxCell>
      <mxCell id="p8e1" edge="1" parent="1" source="p8g1" target="p8go" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p8e2" edge="1" parent="1" source="p8g2" target="p8go" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p8e3" edge="1" parent="1" source="p8g3" target="p8go" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p8e4" edge="1" parent="1" source="p8g4" target="p8go" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p8e5" edge="1" parent="1" source="p8g5" target="p8go" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p8e6" edge="1" parent="1" source="p8g6" target="p8go" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/>
    </root></mxGraphModel>
  </diagram>
