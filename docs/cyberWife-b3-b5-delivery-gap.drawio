      <mxCell id="p1t" value="cyberWife V1｜B3–B5 全局进展与目标体验" style="text;html=1;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1100" height="50" as="geometry"/></mxCell>
      <mxCell id="p1s" value="绿色=已验收　黄色=需修改　蓝色=待新增　红色=阻断风险　灰色=外部/历史" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#17262F;strokeColor=#49606C;fontColor=#D8E5E8;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="780" height="42" as="geometry"/></mxCell>
      <mxCell id="p1b0" value="B0 PASS&#xa;启动/真实探针" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="180" height="90" as="geometry"/></mxCell>
