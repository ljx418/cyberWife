      <mxCell id="p3avatar" value="WSL Avatar :8010&#xa;Wav2Lip256 / LiveTalking&#xa;PCM输入 → Annex-B H.264" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1270" y="260" width="270" height="140" as="geometry"/></mxCell>
