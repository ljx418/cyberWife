  <diagram id="p2" name="02-当前实现与真实缺口">
    <mxGraphModel dx="1422" dy="762" grid="1" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="p2t" value="当前实现 As-Is｜不能被文件存在或mock测试掩盖的缺口" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1300" height="50" as="geometry"/></mxCell>
      <mxCell id="p2a" value="已验收可复用&#xa;&#xa;RuntimeLauncher真实探针/按组件恢复&#xa;PCM→ASR→LLM真实链&#xa;CosyVoice普通链≤7秒&#xa;H.264/WebCodecs Avatar恢复&#xa;照片→正面化→10秒Idle→人工确认&#xa;WarmResponseCache安全门" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="410" height="300" as="geometry"/></mxCell>
      <mxCell id="p2b" value="B3 + ARCH1 已闭环&#xa;&#xa;SessionRuntime持续receiver+单sender已实现&#xa;CancellationToken/InterruptionController已实现&#xa;MediaSession与Avatar按generation清理&#xa;30次真实链打断旧轮泄漏=0&#xa;Application反向导入=0，AST门禁持续执行" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1E6B50;strokeColor=#70D6A7;fontColor=#FFFFFF;align=left;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="130" width="480" height="300" as="geometry"/></mxCell>
      <mxCell id="p2c" value="B4/B5 基线缺口（已闭环）&#xa;&#xa;MemoryService/RetentionService已实现&#xa;SQLite记忆CRUD/审计与向量事务已实现&#xa;no-record整场补偿与零写入已验收&#xa;授权/资产版本API已完整&#xa;App.tsx与生产静态入口已交付" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1010" y="130" width="510" height="300" as="geometry"/></mxCell>
      <mxCell id="p2risk" value="独立审计剩余黄项&#xa;AC-11仅覆盖axe/焦点/减少动效，未跑真读屏完整任务｜授权WAV不等于真实麦克风自由对话｜目标机一键启动不等于干净机安装；NFR-07分层与UX5 A/V量化已关闭" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="170" y="520" width="1260" height="110" as="geometry"/></mxCell>
      <mxCell id="p2rule" value="禁止的实施捷径：在阻塞WS上只加cancel分支｜用FTS-only/内存索引冒充向量ready｜UI隐藏冒充删除｜UI假状态冒充进程恢复｜缓存命中混入普通首响" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=16;" vertex="1" parent="1"><mxGeometry x="170" y="680" width="1260" height="90" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
