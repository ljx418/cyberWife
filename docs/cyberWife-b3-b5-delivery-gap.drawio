      <mxCell id="p1b2" value="B2 PASS&#xa;H.264 Avatar恢复" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="180" width="190" height="90" as="geometry"/></mxCell>
      <mxCell id="p1b3" value="B3 PASS&#xa;30次打断P95=2.6ms&#xa;100轮授权音频压力&#xa;60分钟组合证据" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="180" width="190" height="90" as="geometry"/></mxCell>
      <mxCell id="p1b4" value="B4 PASS&#xa;记忆/删除/不记录/保留" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="180" width="200" height="90" as="geometry"/></mxCell>
      <mxCell id="p1b5" value="B5 FAIL｜发布阻断&#xa;30/30对话动作通过；Windows余量硬门失败" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8B2E2E;strokeColor=#FF8C87;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="330" width="430" height="100" as="geometry"/></mxCell>
      <mxCell id="p1goal" value="目标体验闭环&#xa;&#xa;一键启动 → 自然连续说话 → 可随时插话 → 人物与声音不断线 → 记忆可查改删 → 本次不记录零业务持久化 → 故障原页恢复 → 安全退出" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=18;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="130" y="500" width="1270" height="160" as="geometry"/></mxCell>
      <mxCell id="p1gate" value="当前真实状态：UX4照片→10秒无缝Idle→人工确认、UX5真实口型量化、ARCH1单向依赖均PASS；独立60分钟复验20完整+10打断通过，但Windows最低可用1,840.566MiB&lt;2GiB，G4红；读屏、物理麦克风与干净机安装仍为黄项。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#8B2E2E;strokeColor=#FF8C87;fontColor=#FFFFFF;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="300" y="720" width="930" height="70" as="geometry"/></mxCell>
      <mxCell id="p1e1" edge="1" parent="1" source="p1b0" target="p1b1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p1e2" edge="1" parent="1" source="p1b1" target="p1b25" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p1e3" edge="1" parent="1" source="p1b25" target="p1b2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p1e4" edge="1" parent="1" source="p1b2" target="p1b3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p1e5" edge="1" parent="1" source="p1b3" target="p1b4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="p1e6" edge="1" parent="1" source="p1b4" target="p1b5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/>
