        <mxCell id="i-o1" value="O1 计量基线&#xa;浏览器首个非静音确认&#xa;三类分桶、30条复跑&#xa;门：口径可重复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="70" y="190" width="210" height="145" as="geometry"/></mxCell>
