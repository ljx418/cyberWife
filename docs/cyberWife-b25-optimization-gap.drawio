        <mxCell id="i-o3" value="O3 Cosy TensorRT&#xa;固定engine版本与哈希&#xa;30条质量/全链/资源&#xa;门：可回退且达硬门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="580" y="180" width="230" height="165" as="geometry"/></mxCell>
        <mxCell id="i-o4" value="O4 条件LLM加速&#xa;仅前路仍失败时评估&#xa;vLLM或TensorRT-LLM二选一&#xa;门：质量/取消/资源无回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="850" y="180" width="245" height="165" as="geometry"/></mxCell>
        <mxCell id="i-o5" value="O5 严格问候预热&#xa;≤6项/≤64MiB/零落盘&#xa;正例命中、负例零误命中&#xa;门：版本失效正确" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="1135" y="180" width="230" height="165" as="geometry"/></mxCell>
        <mxCell id="i-o6" value="O6 分阶段验收&#xa;B2.5：首响/缓存&#xa;B2：Avatar恢复；B3：打断&#xa;B5：OX-01～12完整重跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="1405" y="180" width="210" height="165" as="geometry"/></mxCell>
        <mxCell id="ie1" edge="1" parent="i1" source="i-o1" target="i-o2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ie2" edge="1" parent="i1" source="i-o2" target="i-o3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ie3" value="仍未达门" edge="1" parent="i1" source="i-o3" target="i-o4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ie4" edge="1" parent="i1" source="i-o4" target="i-o5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ie5" edge="1" parent="i1" source="i-o5" target="i-o6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-fast" value="任一较低复杂度路线已经让普通链达门 → 停止扩大技术栈，直接执行O5/O6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="330" y="425" width="775" height="70" as="geometry"/></mxCell>
        <mxCell id="i-rollback" value="统一回滚协议&#xa;1. 关闭单一feature flag&#xa;2. 释放失败运行时再串行加载基线，禁止双常驻&#xa;3. 删除engine/预热PCM等派生物，不改数据库与源模型&#xa;4. 重跑普通30条、缓存负例、FPS、资源、全回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;align=left;spacingLeft=18;" vertex="1" parent="i1"><mxGeometry x="90" y="600" width="650" height="210" as="geometry"/></mxCell>
        <mxCell id="i-stop" value="停线并返回计划阶段&#xa;普通P50/P95失败｜CER/盲听失败｜RAM/VRAM越门&#xa;缓存负例误命中｜旧generation泄漏｜需要改UI主路由&#xa;需要降PRD门槛或删除Qwen回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontStyle=1;align=left;spacingLeft=18;" vertex="1" parent="i1"><mxGeometry x="820" y="600" width="650" height="210" as="geometry"/></mxCell>
        <mxCell id="i-out" value="当前授权边界：自动化开发已获批准。每个子阶段先审计再实作；真实证据不达门即停线，不以Mock或后序证据提前签署。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e2530;strokeColor=#0e2530;fontColor=#ffffff;fontSize=18;fontStyle=1;" vertex="1" parent="i1"><mxGeometry x="90" y="895" width="1380" height="75" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="acceptance" name="5-历史验收门槛与步骤">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root><mxCell id="a0"/><mxCell id="a1" parent="a0"/>
        <mxCell id="a-title" value="B2.5 用户场景、操作步骤与硬出门门" style="text;html=1;fontSize=28;fontStyle=1;align=left;fontColor=#13212a;" vertex="1" parent="a1"><mxGeometry x="60" y="35" width="1450" height="50" as="geometry"/></mxCell>
        <mxCell id="a-normal" value="普通问题（OX-01/02）&#xa;操作：30条3～10秒普通语料，预热一次后连续测&#xa;证据：浏览器首个非静音CSV、WAV、CER、盲听&#xa;门：P50≤2.0s/P95≤3.5s；CER≤5%；盲听≥4/5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="70" y="130" width="700" height="150" as="geometry"/></mxCell>
        <mxCell id="a-cache" value="常用问候与负例（OX-03/04/05）&#xa;操作：8正例×3轮；天气/记忆/继续说/附加语义≥24负例；变更4类版本&#xa;证据：HIT/MISS事件、PCM哈希、缓存大小&#xa;门：正例100%合法命中/P95≤0.8s；负例和旧版本误命中=0；≤64MiB/零落盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="820" y="130" width="720" height="150" as="geometry"/></mxCell>
        <mxCell id="a-interrupt" value="打断接续（OX-06，B3首次签署）&#xa;操作：回答早/中/晚各10次插话并立刻提新问题&#xa;证据：generation、音频设备静音、迟到事件注入&#xa;门：静音P95≤400ms；旧音频/字幕/帧/写入=0；B5重跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="70" y="340" width="700" height="140" as="geometry"/></mxCell>
        <mxCell id="a-fail" value="引擎故障与回退（OX-07/12）&#xa;操作：构建失败、加载失败、运行崩溃；关闭全部优化&#xa;证据：健康状态、PID/端口、回滚后30条与回归&#xa;门：≤3s可见；不伪报ready；无需重做设置；基线可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="820" y="340" width="720" height="140" as="geometry"/></mxCell>
        <mxCell id="a-resource" value="资源与稳定（OX-08）&#xa;操作：30条+20轮混合，逐分钟采样RAM/VRAM/swap/queue/task&#xa;门：RAM≤14GB；VRAM≤22GB；宿主/WSL可用≥2GB；无持续swap-in与队列增长" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="70" y="540" width="700" height="130" as="geometry"/></mxCell>
        <mxCell id="a-avatar" value="Avatar恢复（OX-09，B2）+ 离线（OX-10，B2.5）&#xa;操作：采infer/final FPS、终止恢复；断网启动预热对话并监控出站&#xa;门：双FPS≥25；≤2s静态降级且音频不中断；仅loopback；出站=0；B5重跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="820" y="540" width="720" height="130" as="geometry"/></mxCell>
        <mxCell id="a-ui" value="体验无回退（OX-11）&#xa;操作：1920/1366/420完成开聊、打断、故障；键盘/读屏/reduced-motion&#xa;门：路由/主操作不变；无遮挡溢出；状态可播报；主屏技术术语=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="a1"><mxGeometry x="70" y="730" width="700" height="130" as="geometry"/></mxCell>
        <mxCell id="a-exit" value="最终出门&#xa;OX-01～12全部PASS + 全回归无新增失败 + 开放P0/P1=0&#xa;普通路径未混入缓存命中 + Qwen/原adapter回退存在&#xa;随后回填B2；只有B2明确PASS才能进入B3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e2530;strokeColor=#0e2530;fontColor=#ffffff;fontSize=18;fontStyle=1;" vertex="1" parent="a1"><mxGeometry x="820" y="720" width="720" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="risk" name="6-历史风险闭环与审批">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root><mxCell id="r0"/><mxCell id="r1" parent="r0"/>
        <mxCell id="r-title" value="内部风险闭环、备选路线与下一审批门" style="text;html=1;fontSize=28;fontStyle=1;align=left;fontColor=#13212a;" vertex="1" parent="r1"><mxGeometry x="60" y="35" width="1450" height="50" as="geometry"/></mxCell>
        <mxCell id="r1a" value="P1-01 阶段循环（ADR-009已闭环）&#xa;B2.5验首响/缓存；B2验Avatar恢复&#xa;B3验打断；B5做完整组合回归&#xa;门槛与样本数均不降低" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="70" y="130" width="460" height="135" as="geometry"/></mxCell>
        <mxCell id="r2a" value="P1-02 缓存作弊（已闭环到文档）&#xa;普通/命中/失效强制分桶；AC-04只用普通未命中&#xa;负例误命中一次即FAIL并关闭缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="570" y="130" width="460" height="135" as="geometry"/></mxCell>
        <mxCell id="r3a" value="P1-03 RAM余量过小（已闭环到门槛）&#xa;禁止双TTS/双LLM常驻；缓存≤64MiB&#xa;RAM≤14GB且两侧可用≥2GB；越门回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="1070" y="130" width="460" height="135" as="geometry"/></mxCell>
        <mxCell id="r4a" value="P1-04 引擎兼容与技术债（已闭环到架构）&#xa;稳定Port、固定版本、可删engine、逐级启用&#xa;低风险路线达门即停，不强制引入vLLM/TRT-LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="320" y="330" width="500" height="135" as="geometry"/></mxCell>
        <mxCell id="r5a" value="P1-05 体验/语义回退（已闭环到验收）&#xa;G-OX冻结主舞台；完整句精确匹配；版本键失效&#xa;主屏技术术语=0；OX-11三尺寸与无障碍回归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="860" y="330" width="500" height="135" as="geometry"/></mxCell>
        <mxCell id="r-route1" value="路线A 推荐&#xa;llama低风险调优 + Cosy TensorRT + 严格缓存&#xa;优：迁移/回滚成本可控；沿用现有端口&#xa;劣：TensorRT算子兼容仍需真机验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="120" y="575" width="620" height="170" as="geometry"/></mxCell>
        <mxCell id="r-route2" value="路线B 条件备选&#xa;引入vLLM或TensorRT-LLM（二选一）&#xa;优：可能进一步降低LLM首句&#xa;劣：版本、显存、部署和取消合同成本更高；仅A仍失败时进入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;align=left;spacingLeft=16;" vertex="1" parent="r1"><mxGeometry x="820" y="575" width="620" height="170" as="geometry"/></mxCell>
        <mxCell id="r-gate" value="当前审批结论&#xa;G-OX：APPROVED　DOC-O：候选已完成　内部审计：无开放P0/P1（见审计文档）&#xa;下一步：人类审查本Draw.io方向。批准后才执行外部文档审查；外审闭环后才请求产品代码开发授权。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e2530;strokeColor=#0e2530;fontColor=#ffffff;fontSize=18;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="120" y="835" width="1320" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
