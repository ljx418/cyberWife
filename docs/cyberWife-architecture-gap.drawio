      <mxCell id="a" value="Avatar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="90" width="120" height="55" as="geometry"/></mxCell>
      <mxCell id="n1" value="1｜20ms PCM 二进制帧 → Gateway 校验 → 有界输入队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fc6c9;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="740" height="55" as="geometry"/></mxCell>
      <mxCell id="n2" value="2｜VAD speech_end → ASR final → 创建 turn(generation=N)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fc6c9;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="500" y="270" width="590" height="55" as="geometry"/></mxCell>
      <mxCell id="n3" value="3｜PromptCompiler → LLM token stream → Sanitizer语义切句 → Qwen TTS 首句" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fc6c9;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="630" y="350" width="710" height="55" as="geometry"/></mxCell>
      <mxCell id="n4" value="4｜音频 chunk 播放；同一时间戳送 Avatar，视频迟到可丢、音频不可阻塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fc6c9;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="1480" height="55" as="geometry"/></mxCell>
      <mxCell id="interrupt" value="5｜用户插话：VAD 命中 → generation=N+1 → 并行 cancel LLM/TTS/播放/Avatar → purge queues → listening" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="535" width="1480" height="75" as="geometry"/></mxCell>
      <mxCell id="inv" value="硬不变量｜任何 chunk/字幕/帧/记忆写入在副作用前检查 token；旧 generation 结果全部丢弃；cancel 幂等；静音 P95≤400ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e2530;strokeColor=#d3a06f;fontColor=#ffffff;fontSize=17;" vertex="1" parent="1"><mxGeometry x="70" y="670" width="1480" height="90" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="v2p6" name="06-历史Gap风险与模型决策">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="架构 Gap、失败风险与技术路线" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1100" height="45" as="geometry"/></mxCell>
      <mxCell id="r1" value="P1｜一键启动不可用&#xa;证据：Gateway --config 不存在；8090 probe 路径错误；只启两个进程&#xa;路线：B0 首先修合同与回滚，未通过不得做模型串联" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="710" height="125" as="geometry"/></mxCell>
      <mxCell id="r2" value="已闭环｜首响与Avatar传输&#xa;Cosy普通链P95=6.392s；H.264/WebCodecs三周期恢复PASS&#xa;资源13.157GiB，宿主余量仅约0.3GiB；B3禁止新增常驻大模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="710" height="125" as="geometry"/></mxCell>
      <mxCell id="r3" value="P1｜打断可能串音/串轮&#xa;证据：仅 LLM cancel 接口，浏览器/TTS/Avatar无统一 generation&#xa;路线：CancellationToken 传播 + queue purge + 迟到注入测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="710" height="125" as="geometry"/></mxCell>
      <mxCell id="r4" value="P1｜ready 状态不可信&#xa;证据：HealthAggregator 按 registry status 推断，资源为空&#xa;路线：五类 functional probe + runtime metrics，PID/端口仅作辅助" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=left;spacingLeft=15;" vertex="1" parent="1"><mxGeometry x="820" y="260" width="710" height="125" as="geometry"/></mxCell>
      <mxCell id="qwen" value="默认路线｜Qwen3-TTS&#xa;已知：固定样本 CER=0%&#xa;待补：同口径首包、30次稳定、组合驻留、授权盲听&#xa;结论：进入 B2 主线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="170" y="470" width="520" height="170" as="geometry"/></mxCell>
      <mxCell id="cosy" value="已选路线｜CosyVoice2 非TensorRT&#xa;CER=0.71%；普通全链P95=6.392s；盲听5/5&#xa;TensorRT因尾延迟回退拒绝；Qwen保留显式回退&#xa;B5重跑声音、首响与资源组合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1"><mxGeometry x="910" y="470" width="520" height="170" as="geometry"/></mxCell>
      <mxCell id="gate" value="Cosy 切换门：CER≤5%｜首包 P95≤3.5s｜30次无hang/漂移｜组合VRAM≤22GB｜盲听不低于Qwen｜单独ADR批准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="700" width="1260" height="75" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="v2p7" name="07-历史开发与验收计划">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="后端开发计划｜每阶段必须真实验收后再前进" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1150" height="45" as="geometry"/></mxCell>
      <mxCell id="b0" value="B0 可运行基线&#xa;修Launcher/真实Health/llama binary&#xa;门：四进程真实probe；幂等启停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="230" height="135" as="geometry"/></mxCell>
      <mxCell id="b1" value="B1 输入与文本主链&#xa;SpeechRuntime/TurnPipeline/WS&#xa;门：20轮≥95%；队列回零" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="310" y="130" width="230" height="135" as="geometry"/></mxCell>
      <mxCell id="b2" value="B2/B2.5 已通过&#xa;CosyVoice/H.264 Avatar/缓存&#xa;首响/FPS/资源/降级均有真实证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="230" height="135" as="geometry"/></mxCell>
      <mxCell id="b3" value="B3 打断与长稳态&#xa;CancellationToken/故障注入&#xa;门：30/30打断；1h无积压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="230" height="135" as="geometry"/></mxCell>
      <mxCell id="b4" value="B4 记忆与隐私&#xa;Memory/Retention/no-record&#xa;门：删除0召回；不记录0写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="230" height="135" as="geometry"/></mxCell>
      <mxCell id="b5" value="B5 V1总验收&#xa;断网/恢复/一键/发布资料&#xa;门：AC01-14全Pass；P0/P1=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1350" y="130" width="200" height="135" as="geometry"/></mxCell>
      <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="package" value="每阶段完整交付包（不得只交代码）&#xa;①代码/配置　②单元+合同+集成　③真实模型smoke　④JUnit/JSON/CSV　⑤脱敏日志/截图/视频　⑥阶段审计　⑦追踪矩阵更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e2530;strokeColor=#d3a06f;fontColor=#ffffff;fontSize=17;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="1440" height="110" as="geometry"/></mxCell>
      <mxCell id="stop" value="停线规则&#xa;原始音频落盘/非loopback/敏感日志 → 立即停线｜VRAM&gt;22GB或项目RAM&gt;14GB/两侧可用&lt;2GB → 回退后仍超限则停线&#xa;首响/打断/FPS/成功率未达 → 不跨里程碑｜用mock或缓存命中替代普通真实链 → 验收失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="80" y="525" width="1440" height="130" as="geometry"/></mxCell>
      <mxCell id="review" value="当前门禁：仅文档开发。人类批准本图方向后，才进入外部文档审查；全部文档审查通过并明确授权后，才允许 DEV-B0 修改产品代码。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="720" width="1440" height="75" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="v2p8" name="08-历史V1验收门槛与出门">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="V1 验收门槛｜用户场景、操作与硬结果" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1100" height="45" as="geometry"/></mxCell>
      <mxCell id="a1" value="AC03 连续对话&#xa;操作：自然+固定语料共20轮&#xa;门：成功≥19/20；合法状态；不串轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="105" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="a2" value="AC04 首响与资源&#xa;操作：预热后30条普通未命中，采浏览器首个非静音样本&#xa;门：P50≤2s/P95≤3.5s；VRAM≤22GB/项目RAM≤14GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="435" y="105" width="350" height="125" as="geometry"/></mxCell>
      <mxCell id="a3" value="AC05 打断隔离&#xa;操作：早/中/晚各10次并注入迟到chunk&#xa;门：静音P95≤400ms；旧轮音/字/帧/记忆=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="820" y="105" width="350" height="125" as="geometry"/></mxCell>
      <mxCell id="a4" value="AC06 数字人降级&#xa;操作：播放中终止Avatar并恢复&#xa;门：双FPS≥25；2秒内静态降级；语音不断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1205" y="105" width="330" height="125" as="geometry"/></mxCell>
      <mxCell id="a5" value="AC08-10 数据隐私&#xa;操作：编辑/单删/全清/no-record/时钟+31天&#xa;门：源/FTS/vector/缓存0命中；不记录0增量；长期记忆不误删" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="285" width="455" height="140" as="geometry"/></mxCell>
      <mxCell id="a6" value="AC12-13 故障与断网&#xa;操作：逐个杀LLM/ASR/TTS/Avatar/Embedding；断网跑核心路径&#xa;门：降级符合规格；恢复无需刷新；仅loopback；未声明出站=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="575" y="285" width="455" height="140" as="geometry"/></mxCell>
      <mxCell id="a7" value="AC14 一键与1小时&#xa;操作：start两次→混合会话/打断/设置→recover→stop两次&#xa;门：无崩溃/OOM/积压；命令幂等；残留PID/端口/临时音频=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1080" y="285" width="455" height="140" as="geometry"/></mxCell>
      <mxCell id="evidence" value="证据最小集｜环境+模型哈希｜JUnit/合同报告｜20轮事件流｜latency.csv｜30次打断｜FPS/资源曲线｜DB/索引删除报告｜断网/端口/日志扫描｜1h soak｜场景视频" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="1465" height="95" as="geometry"/></mxCell>
      <mxCell id="go" value="V1 GO&#xa;AC-01～AC-14 全部 Pass｜开放 P0/P1=0｜前端真实接线回归通过｜安装/备份/恢复/卸载/删除手册演练完成&#xa;任何 mock、PID、端口或界面演示都不能替代真实模型和目标硬件证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="665" width="1465" height="125" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
