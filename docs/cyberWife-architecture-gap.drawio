  <diagram id="v2p1" name="01-历史目标体验与后端范围">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#071018"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="t" value="历史设计基线｜G-UX通过后的后端规划（非当前状态）" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#f2f4f3;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="30" width="1100" height="50" as="geometry"/></mxCell>
      <mxCell id="ux" value="已冻结体验（绿色）&#xa;一键进入陪伴｜连续语音｜字幕与六态｜设置/记忆/隐私｜可理解降级&#xa;后续仅允许后端接线与回归修复，不做视觉重构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="1480" height="110" as="geometry"/></mxCell>
      <mxCell id="goal" value="V1 后端目标&#xa;本地一键启动后，真实贯通 VAD → ASR → LLM → CosyVoice → H.264 Avatar；支持无限多轮、统一打断、记忆可删、断网可用与故障恢复。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e2530;strokeColor=#d3a06f;fontColor=#ffffff;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="1480" height="110" as="geometry"/></mxCell>
      <mxCell id="g1" value="首响（历史门槛）&#xa;现行PRD：P95≤7.0s&#xa;P50仅记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="80" y="430" width="240" height="120" as="geometry"/></mxCell>
      <mxCell id="g2" value="打断&#xa;静音 P95≤400ms&#xa;旧轮泄漏=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="380" y="430" width="240" height="120" as="geometry"/></mxCell>
      <mxCell id="g3" value="多轮稳定&#xa;20轮成功率≥95%&#xa;1小时无OOM/积压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="240" height="120" as="geometry"/></mxCell>
      <mxCell id="g4" value="数字人&#xa;inferfps/finalfps≥25&#xa;Avatar失败语音继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="980" y="430" width="240" height="120" as="geometry"/></mxCell>
      <mxCell id="g5" value="隐私与删除&#xa;断网完整可用&#xa;删除后召回=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1280" y="430" width="240" height="120" as="geometry"/></mxCell>
      <mxCell id="scope" value="V1 固定边界｜Windows 11 + WSL2 原生进程｜32GB RAM / RTX4090 24GB｜仅 loopback｜无 Docker、无公网、无多用户/多角色" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="1440" height="75" as="geometry"/></mxCell>
      <mxCell id="legend" value="归档说明：本图保留开发前设计语境，不代表当前实现；当前唯一权威阶段图为 cyberWife-b3-b5-delivery-gap.drawio。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8fc6c9;fontColor=#13212a;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="1440" height="55" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
