<mxfile host="Electron" agent="Codex" pages="8">
  <diagram id="v2x1" name="01-范围进展与目标体验"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t1" value="cyberWife V2-X｜范围、进展与目标体验" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="l1" value="绿色=已实现/已验收　黄色=需修改　蓝色=待新增　红色=停线风险　灰色=V2-A后续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17262F;strokeColor=#49606C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="900" height="42" as="geometry"/></mxCell>
    <mxCell id="a1" value="V1 基线 PASS&#xa;实时对话/打断/单人物同场景&#xa;首响≤7秒/打断≤400ms&#xa;记忆CRUD/隐私/一键启动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="310" height="190" as="geometry"/></mxCell>
    <mxCell id="a2" value="D0 PASS&#xa;交互原型+真实基线截图&#xa;组件/旅程/架构概念对齐&#xa;项目所有者批准 G-V2X-D0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="430" y="180" width="310" height="190" as="geometry"/></mxCell>
    <mxCell id="a3" value="D1 文档门 PASS&#xa;具体代码实体与分层&#xa;manifest/API/事件/状态合同&#xa;迁移/回滚/验收/双轮审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="790" y="180" width="310" height="190" as="geometry"/></mxCell>
    <mxCell id="a4" value="X0～X3.5 / X8.0 / X9 已PASS&#xa;2外观×3共同场景真实口播与重启恢复&#xa;下一阶段X4状态感知微动作&#xa;最终G-V2X尚未签署" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#FFE0A3;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="1150" y="180" width="360" height="190" as="geometry"/></mxCell>
    <mxCell id="goal1" value="目标体验：同一个人物、同一个场景、同一条实时对话链中，用户可校准输入、恢复会话、控制输出、管理同角色多源素材与场景、查看可追溯记忆，并在负载波动时优先获得连续自然的语音和可回退的视频。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=18;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="130" y="480" width="1340" height="140" as="geometry"/></mxCell>
    <mxCell id="stop1" value="停线：双人物/旧轮复活/未确认视觉事实固化/私密缓存/实时与生成模型双驻/突破14GB RAM或22GB VRAM/V1性能回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#782F3A;strokeColor=#F08A96;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="680" width="1140" height="80" as="geometry"/></mxCell>
    <mxCell id="e11" edge="1" source="a1" target="a2" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="e12" edge="1" source="a2" target="a3" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/><mxCell id="e13" edge="1" source="a3" target="a4" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#8AA0A9;endArrow=block;"/>
  </root></mxGraphModel></diagram>
  <diagram id="v2x2" name="02-AsIs与Target差异"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t2" value="As-Is → Target｜具体实体和状态" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="h21" value="已实现并复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="450" height="50" as="geometry"/></mxCell>
    <mxCell id="b21" value="ConversationClient / AppShell&#xa;InputAudioSessionController&#xa;MediaSession / AvatarSessionController&#xa;TurnPipeline / SessionRuntime / MemoryService&#xa;AssetStore / SqliteMemoryRepository&#xa;HostBridge / 6字段WS envelope / generation fence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="450" height="430" as="geometry"/></mxCell>
    <mxCell id="h22" value="需修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="575" y="100" width="450" height="50" as="geometry"/></mxCell>
    <mxCell id="b22" value="App.tsx：只保留组合，拆出工作台&#xa;InputAudioSession：device/校准/PTT&#xa;MediaSession：gain/compressor/内存重播&#xa;AvatarSession：帧年龄/漂移/质量档&#xa;HostBridge：PWA/全屏能力桥&#xa;api/server.py：新增路由但不放业务规则&#xa;SqliteMemoryRepository：派生图删除传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C8892E;fontColor=#432F14;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="575" y="170" width="450" height="430" as="geometry"/></mxCell>
    <mxCell id="h23" value="待新增" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#215C83;strokeColor=#71B7E6;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="450" height="50" as="geometry"/></mxCell>
    <mxCell id="b23" value="SessionLifecycleController / StagePresentationController&#xa;DevicePanel / OutputControls / SourcePackPanel&#xa;StageControls / MemoryWorkbench / PwaBridge&#xa;ExperienceSettingsService / SourcePackService&#xa;ScenePresetService / VisualClaimService&#xa;MemoryGraphService / QualityGovernor / VoiceStylePolicy&#xa;ExperienceManifestRepository / JsonManifestRepository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FC;strokeColor=#215C83;fontColor=#15313B;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="450" height="430" as="geometry"/></mxCell>
    <mxCell id="v2a2" value="V2-A后续（本阶段禁止）：Character/Space正式聚合、导入导出、外部RAG/MCP/CLI提供方、插件隔离宿主" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#78909C;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="1100" height="80" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="v2x3" name="03-运行分层与代码实体"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t3" value="Target运行架构｜依赖方向与强关联实体" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="ui3" value="浏览器 UI/Controllers&#xa;DevicePanel → InputAudioSession&#xa;OutputControls → MediaSession&#xa;SourcePackPanel/StageControls → ConversationClient&#xa;ConversationScreen → Lifecycle/StagePresentation/AvatarSession" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FC;strokeColor=#215C83;fontColor=#15313B;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="160" y="110" width="1280" height="130" as="geometry"/></mxCell>
    <mxCell id="api3" value="API边界｜server.py + ConversationClient&#xa;loopback REST：设置/manifest/舞台/视觉声明/记忆图/质量　｜　既有WS：实时事件+generation+revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C8892E;fontColor=#432F14;" vertex="1" parent="1"><mxGeometry x="160" y="280" width="1280" height="95" as="geometry"/></mxCell>
    <mxCell id="app3" value="Application&#xa;复用：TurnPipeline / SessionRuntime / MemoryService&#xa;新增：ExperienceSettingsService / SourcePackService / ScenePresetService / VisualClaimService / MemoryGraphService / QualityGovernor / VoiceStylePolicy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="160" y="415" width="1280" height="125" as="geometry"/></mxCell>
    <mxCell id="dp3" value="Domain + Ports&#xa;experience.py / source_pack.py　｜　ExperienceManifestRepository / VisualDescriptionPort / 既有TTS/Avatar/Repository ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EAF8;strokeColor=#81579C;fontColor=#35243F;" vertex="1" parent="1"><mxGeometry x="160" y="580" width="1280" height="90" as="geometry"/></mxCell>
    <mxCell id="infra3" value="Infrastructure/Adapters&#xa;JsonManifestRepository（原子revision）｜SqliteMemoryRepository（源+派生删除）｜本地VisualDescription adapter｜既有CosyVoice/LiveTalking/SQLite/AssetStore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="160" y="710" width="1280" height="90" as="geometry"/></mxCell>
    <mxCell id="e31" edge="1" source="ui3" target="api3" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#506A76;endArrow=block;"/><mxCell id="e32" edge="1" source="api3" target="app3" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#506A76;endArrow=block;"/><mxCell id="e33" edge="1" source="app3" target="dp3" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#506A76;endArrow=block;"/><mxCell id="e34" edge="1" source="infra3" target="dp3" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#506A76;endArrow=block;"/>
  </root></mxGraphModel></diagram>
  <diagram id="v2x4" name="04-输入恢复与音画状态"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t4" value="输入、生命周期与单表面音画状态机" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="input4" value="输入链 X0.1&#xa;stopped→starting→calibrating→listening↔capturing&#xa;device切换：先停旧track，再开新track；活动track≤1&#xa;PTT：未按下不允许起句；后端ASR/VAD仍权威" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FC;strokeColor=#215C83;fontColor=#15313B;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="460" height="220" as="geometry"/></mxCell>
    <mxCell id="life4" value="恢复链 X0.2&#xa;visibility/network/health → 串行恢复队列&#xa;lifecycleGeneration++ → 关闭旧资源 → 探测Gateway&#xa;恢复同一有效session或明确回Idle；旧generation全部丢弃" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C8892E;fontColor=#432F14;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="460" height="220" as="geometry"/></mxCell>
    <mxCell id="av4" value="输出/质量 X0.3+X8.1&#xa;PCM→Gain→Compressor→Meter→Destination&#xa;音频时钟优先；过期视频帧可丢弃，禁止暂停音频追帧&#xa;连续窗口+迟滞+冷却期：高→中→低→Idle/静态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="1070" y="120" width="460" height="220" as="geometry"/></mxCell>
    <mxCell id="stage4" value="StagePresentationController X3.2～X4&#xa;intro → idle → listening_cue → thinking_cue → pre_speech → live_talking → recovery_cue → idle → outro&#xa;每次切换先确认目标ready，再原子显现；任何时刻一个人物表面；live Canvas拥有口型时钟；缺素材/减少动效/降级均回approved Idle或静态图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=17;align=left;spacing=20;" vertex="1" parent="1"><mxGeometry x="160" y="440" width="1280" height="170" as="geometry"/></mxCell>
    <mxCell id="fail4" value="故障不变量：新轮不复活旧轮｜打断清理PCM/视频/重播缓存｜恢复不创建重复会话｜切换不黑帧/遮罩/闪动｜素材缺失不显示第二人物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#782F3A;strokeColor=#F08A96;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="680" width="1160" height="80" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="v2x5" name="05-素材记忆与迁移"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t5" value="私有数据、manifest、视觉声明与记忆派生" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="src5" value="原图只读 source&#xa;UUID + SHA-256 + consent_id&#xa;angle/appearance_label/provenance&#xa;路径由服务端生成并校验根目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FC;strokeColor=#215C83;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="man5" value="SourcePackService + JsonManifestRepository&#xa;staging→schema/media/hash检查→人工批准→revision CAS→原子替换&#xa;失败保持上一active；UUID永不重写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C8892E;fontColor=#432F14;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="420" height="210" as="geometry"/></mxCell>
    <mxCell id="rend5" value="appearance / scene / rendition 已实现&#xa;一个活动角色内的2外观×3共同场景&#xa;appearance+scene同一CAS原子激活&#xa;V2-A登记时沿用现有UUID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="v1f5" value="V1 active asset回退&#xa;flag关闭/迁移失败时继续使用&#xa;不删除新数据，不覆盖旧原图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#607D8B;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="300" height="170" as="geometry"/></mxCell>
    <mxCell id="claim5" value="VisualClaimService&#xa;candidate（模型+来源）→ 用户confirm/reject → confirmed才可进入PromptCompiler&#xa;身体/身份/健康敏感推断禁止成为候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EAF8;strokeColor=#81579C;fontColor=#35243F;" vertex="1" parent="1"><mxGeometry x="130" y="450" width="540" height="170" as="geometry"/></mxCell>
    <mxCell id="mem5" value="MemoryService + SqliteMemoryRepository（权威）&#xa;MemoryGraphService（派生）&#xa;节点/边必须有source_memory_ids；编辑重建；删除同事务清source/FTS/vector/node/edge；删除后零召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="800" y="450" width="670" height="170" as="geometry"/></mxCell>
    <mxCell id="privacy5" value="隐私：私有图像/音频/记忆/manifest不进Git、不进Service Worker、不进验收报告；只记录哈希、计数、状态、版本和脱敏截图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#782F3A;strokeColor=#F08A96;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="700" width="1140" height="75" as="geometry"/></mxCell>
    <mxCell id="e51" edge="1" source="src5" target="man5" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#506A76;"/><mxCell id="e52" edge="1" source="man5" target="rend5" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#506A76;"/><mxCell id="e53" edge="1" source="rend5" target="v1f5" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#506A76;"/>
  </root></mxGraphModel></diagram>
  <diagram id="v2x6" name="06-开发顺序与里程碑"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t6" value="开发顺序｜每阶段先计划审计、后编码、再真实验收" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1300" height="50" as="geometry"/></mxCell>
    <mxCell id="m61" value="X0 PASS&#xa;flag/schema/基线/回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="210" height="100" as="geometry"/></mxCell>
    <mxCell id="m62" value="X0.1～0.3、X9 PASS&#xa;输入/恢复/输出/桌面壳&#xa;AC09/10/11/15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="230" height="100" as="geometry"/></mxCell>
    <mxCell id="m63" value="X1～X3.5 PASS&#xa;素材/构图/7个组合&#xa;AC01/02/03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F6B4A;strokeColor=#6ED39C;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="220" height="100" as="geometry"/></mxCell>
    <mxCell id="m64" value="下一阶段 X4&#xa;状态感知微动作&#xa;AC04/12 + 人工门" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#FFE0A3;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="220" height="100" as="geometry"/></mxCell>
    <mxCell id="m65" value="X5～X6&#xa;视觉确认/记忆工作台&#xa;AC05/06" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#215C83;strokeColor=#71B7E6;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="220" height="100" as="geometry"/></mxCell>
    <mxCell id="m66" value="X8/X8.1/X8.2&#xa;高清口型/治理/声音&#xa;AC08/13/14 + 人工盲评" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#215C83;strokeColor=#71B7E6;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="200" height="100" as="geometry"/></mxCell>
    <mxCell id="m67" value="X7 最终组合回归&#xa;20轮 + 30次打断 + 1小时稳态&#xa;AC01～15证据齐全；P0/P1=0；人工批准后才过G-V2X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=18;" vertex="1" parent="1"><mxGeometry x="410" y="390" width="780" height="140" as="geometry"/></mxCell>
    <mxCell id="rule6" value="每个子阶段固定产物：plan → acceptance → pre-development-audit（P0/P1=0）→ code → tests/real evidence → implementation-audit → prd-review → result。失败回到计划，不以mock、文件存在或概念图冒充体验通过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C8892E;fontColor=#432F14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="650" width="1240" height="100" as="geometry"/></mxCell>
    <mxCell id="e61" edge="1" source="m61" target="m62" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"/><mxCell id="e62" edge="1" source="m62" target="m63" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"/><mxCell id="e63" edge="1" source="m63" target="m64" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"/><mxCell id="e64" edge="1" source="m64" target="m65" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"/><mxCell id="e65" edge="1" source="m65" target="m66" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"/><mxCell id="e66" edge="1" source="m66" target="m67" parent="1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"/>
  </root></mxGraphModel></diagram>
  <diagram id="v2x7" name="07-验收门槛与真实证据"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t7" value="V2-X验收门｜用户场景、操作、证据和硬门" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="u71" value="素材与舞台 AC01～04&#xa;4张授权多角度/全身/穿着图→重启查看；4视口截图；3背景+2外观切换；Idle循环5次&#xa;哈希/授权/派生链完整；无空白溢出；不重置会话；人工自然度≥4/5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FC;strokeColor=#215C83;fontColor=#15313B;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="700" height="180" as="geometry"/></mxCell>
    <mxCell id="u72" value="理解与记忆 AC05～06&#xa;询问穿着/场景并核来源；新增/确认/编辑/搜/聚类/删记忆&#xa;只引用confirmed声明；源/FTS/vector/节点/边同步；删除后零召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EAF8;strokeColor=#81579C;fontColor=#35243F;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="700" height="180" as="geometry"/></mxCell>
    <mxCell id="u73" value="输入/恢复/输出/PWA AC09～11/15&#xa;三种噪声校准+插话+换麦+PTT；隐藏/断网/服务/休眠恢复；音量/静音/重播/sink；安装/全屏/离线缓存检查&#xa;误打断↓≥70%；打断P95≤400ms；track≤1；旧轮=0；私有缓存=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#C8892E;fontColor=#432F14;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="70" y="350" width="700" height="200" as="geometry"/></mxCell>
    <mxCell id="u74" value="表现与音画 AC08/12～14&#xa;同素材音频盲评；完整状态链；三档负载；10条文本三声音预设&#xa;单人物同场景；≥720p有效细节；同步/自然度/身份/声音≥4/5；首响≤7秒；音频不因追帧暂停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="830" y="350" width="700" height="200" as="geometry"/></mxCell>
    <mxCell id="u75" value="最终组合 AC07：多素材+场景+Idle+20轮真实对话+30次真实打断+1小时稳态；AC01～15签署证据齐全；RAM/VRAM/隐私/V1性能无回退；开放P0/P1=0。机器证据不得代签人工自然度与身份保持。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="650" width="1160" height="110" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="v2x8" name="08-风险回滚与出门"><mxGraphModel page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="t8" value="风险闭环、逐项回滚与G-V2X出门" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#15313B;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1200" height="50" as="geometry"/></mxCell>
    <mxCell id="r81" value="P0 数据/隐私&#xa;人物/声音/记忆串用、原图覆盖、未确认事实固化、私有数据入Git/SW&#xa;→ 立即停线；关闭相关flag；恢复上一manifest/SQLite备份；保留隔离staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#782F3A;strokeColor=#F08A96;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="700" height="170" as="geometry"/></mxCell>
    <mxCell id="r82" value="P1 实时/体验&#xa;旧generation复活、双人物、黑帧闪动、首响/打断回退、口型静止、音频为追帧中断&#xa;→ 返回对应子阶段；恢复V1输入/舞台/声音路径；不得降低门槛签署" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="820" y="120" width="700" height="170" as="geometry"/></mxCell>
    <mxCell id="r83" value="P1 资源&#xa;项目不可回收RAM&gt;14GB、VRAM&gt;22GB、余量&lt;2GB、生成与实时模型双驻&#xa;→ 停止重型任务/释放模型/回退低档；重新设计调度，不以交换抖动冒充通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#73521F;strokeColor=#F2BD6B;fontColor=#FFFFFF;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="700" height="170" as="geometry"/></mxCell>
    <mxCell id="r84" value="逐项回退&#xa;每个v2x.* flag独立关闭；manifest恢复上一active revision；数据库迁移只新增、可重复、可备份恢复；关闭增强不删新数据、不重写UUID；浏览器不支持PWA/sink时保留普通入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#1F6B4A;fontColor=#15313B;align=left;spacing=18;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="700" height="170" as="geometry"/></mxCell>
    <mxCell id="exit8" value="G-V2X 出门：D1与X0～X9阶段文档/代码/证据一致；AC01～15全部真实PASS；20轮+30打断+1小时组合回归PASS；P0/P1=0；项目所有者完成人工自然度/身份保持/整体体验批准。通过后才允许V2-A。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B22;strokeColor=#E4A668;fontColor=#EDF4F5;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="650" width="1220" height="120" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
</mxfile>
