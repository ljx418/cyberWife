{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberwife.local/schemas/errors/error_envelope.schema.json",
  "title": "REST 错误响应统一信封（§16 错误码目录）",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "user_action", "trace_id", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "auth.consent_required",
        "consent.revoked",
        "asset.invalid",
        "asset.too_large",
        "asset.version_conflict",
        "session.not_found",
        "session.recording_policy_invalid",
        "memory.not_found",
        "memory.confirm_required",
        "audit.entity_not_found",
        "retention.invalid_clock",
        "health.component_unavailable",
        "health.degraded",
        "frame.size_limit",
        "turn.cancelled",
        "turn.late_event",
        "interrupted",
        "internal.error"
      ]
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 200},
    "user_action": {
      "type": "string",
      "enum": ["open_onboarding", "open_settings", "open_status", "retry", "retry_later", "confirm_dialog", "none"]
    },
    "trace_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "retryable": {"type": "boolean"}
  }
}
