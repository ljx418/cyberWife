{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberwife.local/schemas/rest/asset.schema.json",
  "title": "资产版本（FR-04/05 通用）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "status", "created_at"],
  "properties": {
    "id": {"type": "integer"},
    "kind": {"type": "string", "enum": ["portrait", "voice"]},
    "filename_or_revision": {"type": "string"},
    "relative_path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["uploaded", "previewed", "active", "archived", "rejected"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
