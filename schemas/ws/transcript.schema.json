{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberwife.local/schemas/ws/transcript.schema.json",
  "title": "WS transcript.partial / transcript.final",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "confidence", "kind"],
  "properties": {
    "text": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "kind": {"type": "string", "enum": ["user", "assistant"]},
    "language": {"type": "string"},
    "trace_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "speech_detected": {"type": "boolean"},
    "generation": {"type": "integer", "minimum": 0},
    "asr_final_wall_ms": {"type": "number", "minimum": 0},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start_ms", "end_ms", "text", "confidence"],
        "properties": {
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "text": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
